# Copy this file to .env and fill in real values. Never commit .env.

# Gmail account that sends the emails
SMTP_USER=teemly.website@gmail.com
# 16-character Gmail App Password (myaccount.google.com/apppasswords)
SMTP_PASS=abcdefghijklmnop
# Where form submissions are delivered (comma-separate for multiple)
MAIL_TO=you@yourcompany.com

# Public site URL, used for the buttons in the auto-reply email (optional)
SITE_URL=https://teemly.co

# Port the Node server listens on
PORT=3001
